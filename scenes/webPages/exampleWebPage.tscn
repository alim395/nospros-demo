bbcode_enabled = true
text = "[center][font_size=24][b]Godot 4 RichTextLabel Showroom[/b][/font_size][/center]

[b]1. Basic Formatting:[/b]
This is [b]bold text[/b], this is [i]italic text[/i], this is [u]underlined[/u], and this is [s]strikethrough[/s].

[b]1.1 CODE Formatting:[/b]

[code]print(\"Hello World\")[/code]

[b]2. Colors & Styling:[/b]
You can use [color=red]named colors[/color] or [color=#123456]hex codes[/color].
You can also change the [bgcolor=yellow][color=black]background color[/color][/bgcolor] of text.
[outline_size=4][outline_color=blue][color=yellow]Yellow text with a blue outline![/color][/outline_color][/outline_size]

[b]3. Alignment & Layout Showcase:[/b]

[b]Alignment Variations:[/b]
[left]• This text is forced to [b]Left-Aligned[/b]. This is the standard default configuration for Western languages.[/left]

[center]• This text is [b]Center-Aligned[/b]. Perfect for game titles, major announcements, or item pickup notifications.[/center]

[right]• This text is forced to [b]Right-Aligned[/b]. Often used for timestamps, UI counters, or specific character dialogues.[/right]

[fill]• This text is [b]Justified (Filled)[/b]. Godot will automatically adjust the spacing between words so that both the left and right edges align perfectly with the boundaries of your control box. It looks neat in long lore paragraphs.[/fill]

[b]Unordered Lists (ul):[/b]
[ul]
Bullet Item 1
Bullet Item 2
[ul]Nested Bullet Item A
Nested Bullet Item B[/ul]
Bullet Item 3
[/ul]

[b]Ordered Lists (ol):[/b]
[ol type=1]
First sequential step
Second sequential step
Third sequential step
[/ol]

[b]Ordered Lists with Roman Numerals (ol type=I):[/b]
[ol type=I]
Introduction Chapter
Core Gameplay Mechanics
Credits & Licensing
[/ol]

[b]4. Interactive Elements:[/b]
Hover over this to see a [hint=This is a built-in tooltip!]tooltip hint[/hint].
Clickable links look like this: [url=Boggle]Visit Boggle Website[/url].
[url=download:TEST DOWNLOAD]Try downloading the test file![/url]

[b]5. Built-in Animation Effects:[/b]
• [wave amp=50.0 freq=5.0 connected=1]The wave animation makes text drift up and down.[/wave]
• [tornado radius=5.0 freq=2.0]The tornado animation spins characters around.[/tornado]
• [shake rate=20.0 level=5]The shake animation adds chaotic vibration.[/shake]
• [fade start=4 length=14]The fade effect fades out characters linearly.[/fade]
• [rainbow freq=1.0 sat=0.8 val=0.8]The rainbow effect cycles beautifully through colors.[/rainbow]
"
fit_content = true

